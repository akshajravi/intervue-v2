# Copy to .env.local and fill these in. Everything here is server-side except
# the NEXT_PUBLIC_* vars, which are inlined into the browser bundle.

# The AI interviewer.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Auth. Both from the Clerk dashboard → your app → Configure → API keys.
# The Google SSO connection is enabled dashboard-side, not here.
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional — Clerk already defaults to /sign-in, but setting it explicitly keeps
# redirects correct if the route ever moves.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Interview history. Use the POOLED connection string ("-pooler" in the host),
# not the direct one — serverless functions open a connection per invocation.
# https://console.neon.tech → your project → Connect
DATABASE_URL=

# Per-user rate limiting on the two Claude endpoints.
# https://console.upstash.com → your Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
